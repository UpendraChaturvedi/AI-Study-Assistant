{
  "manifest_version": 3,
  "name": "AI Study Assistant",
  "version": "1.0.0",
  "description": "Select YouTube video segments and instantly generate AI-powered study materials (notes, quizzes, flashcards, mind maps).",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "AI Study Assistant",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "48": "src/assets/icons/icon48.png",
      "128": "src/assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/content.jsx"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:5000/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/icons/*", "assets/*"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
